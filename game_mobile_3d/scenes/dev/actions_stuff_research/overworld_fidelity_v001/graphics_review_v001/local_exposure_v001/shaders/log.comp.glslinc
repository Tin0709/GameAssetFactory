#version 450
layout(local_size_x=8,local_size_y=8)in;layout(set=0,binding=0)uniform sampler2D source_color;layout(r16f,set=0,binding=1)uniform writeonly image2D output_log;layout(std430,set=0,binding=2)readonly buffer Parameters{vec4 p[];};

void main(){
 ivec2 target=ivec2(gl_GlobalInvocationID.xy);
 if(any(greaterThanEqual(target,imageSize(output_log))))return;
 vec3 physical=texelFetch(source_color,target+ivec2(p[0].zw),0).rgb*p[0].x;
 float luminance=max(dot(physical,p[1].xyz),p[0].y);
 imageStore(output_log,target,vec4(log2(luminance)));
}
