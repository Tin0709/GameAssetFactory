#version 450
layout(std430,set=0,binding=1)readonly buffer Parameters{vec4 p[];};layout(location=0)out vec2 coordinates[17];

void main(){
 vec2 corners[3]=vec2[3](vec2(0.,0.),vec2(2.,0.),vec2(0.,2.));
 vec2 uv=corners[gl_VertexIndex];gl_Position=vec4(uv*2.-1.,0.,1.);
 vec2 base=uv*p[0].xy+p[0].zw;
 for(int i=0;i<17;i++)coordinates[i]=base+p[i+1].xy;
}
