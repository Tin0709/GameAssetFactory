extends RefCounted
## Loads a render-only terrain layer from the private research workspace.

const SHADER := preload("res://materials/world_map_distant_terrain.gdshader")
const ROOT := "extracted/2026-10-25 19-26-25/Game/Spicewood"
const MESH_PATH := "AutoGenerated/World/ChunkedAreaMeshes/cs01_forestarea/Chunk_-310400_188800_6400/Terrain/SM_MeshPackage_InGameMeshes.glb"
const MESH_SHA := "781a46ed18dd6551665276bf378d498fed164c5567c37c22f9c563d58ba11c63"
const ATLAS_PATH := "Materials/Master/Lovika/Overrides/Textures/Overworld/T_OverworldAtlas_D.png"
const ATLAS_SHA := "4db8d16e986366be22626ae82e1a9af5382f6987eff0f782ab5a72805292f397"
const SECTIONS := [&"InGame_SM_Terrain_30_", &"InGame_SM_Terrain_31_", &"InGame_SM_Terrain_32_",
	&"InGame_SM_Terrain_34_", &"InGame_SM_Terrain_35_"]
const MESH_ANCHOR := Vector3(16., 38., 16.)

var visual: MeshInstance3D
var material: ShaderMaterial
var _attempted := false
var _submitted := Vector4.INF

static func phase_weight(hour: float) -> float:
	return smoothstep(17., 18.5, hour) * (1. - smoothstep(20., 21.35, hour))

func visible() -> bool:
	return is_instance_valid(visual) and visual.is_visible_in_tree()

func update(weight: float, tint: Color) -> void:
	if not is_instance_valid(visual):
		return
	visual.visible = weight > 0.
	if weight <= 0.:
		return
	var color := tint.srgb_to_linear()
	var state := Vector4(color.r * .13, color.g * .13, color.b * .13, weight * .84)
	if state == _submitted:
		return
	_submitted = state
	material.set_shader_parameter("distant_light", Vector3(state.x, state.y, state.z))
	material.set_shader_parameter("visibility_scale", state.w)

func prepare(world: Node3D, origin: Vector3, expected_layout_sha: String) -> void:
	if _attempted or not is_instance_valid(world) or not origin.is_finite() \
			or not OS.has_feature("editor") or RenderingServer.get_current_rendering_method() != "mobile" \
			or RenderingServer.get_rendering_device() == null:
		return
	_attempted = true
	if expected_layout_sha.is_empty() or FileAccess.get_sha256(world.map_layout_path) != expected_layout_sha:
		return
	var root := OS.get_environment("MD2_RESEARCH_ROOT")
	if root.is_empty():
		root = OS.get_environment("USERPROFILE").path_join("Desktop/MD2 Research")
	root = root.simplify_path().replace("\\", "/").trim_suffix("/")
	var project := ProjectSettings.globalize_path("res://../").simplify_path().replace("\\", "/").trim_suffix("/").to_lower()
	if not root.is_absolute_path() or root.begins_with("res://") or root.begins_with("user://") \
			or root.to_lower() == project or root.to_lower().begins_with(project + "/"):
		return
	var mesh_path := root.path_join(ROOT).path_join(MESH_PATH)
	var atlas_path := root.path_join(ROOT).path_join(ATLAS_PATH)
	if FileAccess.get_sha256(mesh_path) != MESH_SHA or FileAccess.get_sha256(atlas_path) != ATLAS_SHA:
		return
	var mesh := _read_terrain(mesh_path)
	if mesh == null:
		return
	var image := Image.load_from_file(atlas_path)
	if image == null or image.is_empty():
		return
	image.generate_mipmaps()
	material = ShaderMaterial.new()
	material.shader = SHADER
	material.render_priority = -10
	material.set_shader_parameter("terrain_atlas", ImageTexture.create_from_image(image))
	visual = MeshInstance3D.new()
	visual.name = "PrivateDistantTerrain"
	visual.mesh = mesh
	visual.set_surface_override_material(0, material)
	visual.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	visual.position = origin
	visual.hide()
	world.add_child(visual)

func _read_terrain(path: String) -> ArrayMesh:
	var document := GLTFDocument.new()
	var state := GLTFState.new()
	if document.append_from_file(path, state) != OK:
		return null
	var source := document.generate_scene(state)
	if source == null:
		return null
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var found := {}
	for part: MeshInstance3D in source.find_children("*", "MeshInstance3D", true, false):
		if part.name in SECTIONS and part.mesh != null and part.mesh.get_surface_count() == 1 and part.transform == Transform3D.IDENTITY:
			surface.append_from(part.mesh, 0, Transform3D(Basis.IDENTITY, -MESH_ANCHOR))
			found[part.name] = true
	source.free()
	if found.size() != SECTIONS.size():
		return null
	return surface.commit()
