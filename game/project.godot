config_version=5

[application]
config/name="Survivor — First Slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[autoload]
Sound="*res://scripts/sound.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
restart={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}

[layer_names]
2d_physics/layer_1="Player"
2d_physics/layer_2="Zombies"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055,0.075,0.09,1)
