        }
      ],
      "blend_transition": 0.16
    },
    "hwuwvi": {
      "particle_effects": [
        {
          "effect": "hwuwvi"
        },
        {
          "effect": "djnihu"
        },
        {
          "effect": "cbcewo"
        }
      ],
      "transitions": [
        {
          "default": "!q.is_in_water"
        }
      ]
    }
  }
