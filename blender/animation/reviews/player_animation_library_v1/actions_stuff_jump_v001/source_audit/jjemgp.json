{
  "initial_state": "default",
  "states": {
    "default": {
      "transitions": [
        {
          "jump": "!q.is_on_ground&&q.vertical_speed>2&&!q.is_in_water"
        }
      ]
    },
    "jump": {
      "animations": [
        "jump"
      ],
      "transitions": [
        {
          "default": "q.is_on_ground||q.is_in_water||(q.vertical_speed<-0.15&&q.state_time>0.174)"
        }
      ],
      "blend_transition": 0.3
    }
  }
}