{
  "states": {
    "default": {
      "transitions": [
        {
          "fall": "q.vertical_speed<2&&!q.is_on_ground&&q.state_time>0.2"
        }
      ]
    },
    "fall": {
      "animations": [
        "fall",
        {
          "ryyeuf": "q.is_on_ground?0.01"
        }
      ],
      "transitions": [
        {
          "hwuwvi": "q.is_in_water"
        },
        {
          "default": "(q.is_on_ground&&q.any_animation_finished)||q.vertical_speed>0"
        }
      ],
      "blend_transition": 0.18
    },
    "hwuwvi": {
      "particle_effects": [
        {
          "effect": "hwuwvi"
        },
        {
          "effect": "djnihu"
        },
        {
          "effect": "cbcewo"
        }
      ],
      "transitions": [
        {
          "default": "!q.is_in_water&&q.is_on_ground"
        }
      ]
    }
  }
}