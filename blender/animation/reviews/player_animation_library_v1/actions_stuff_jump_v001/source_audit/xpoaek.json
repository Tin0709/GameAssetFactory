{
  "states": {
    "default": {
      "transitions": [
        {
          "up": "!q.is_on_ground&&!q.is_in_water&&q.vertical_speed>0"
        }
      ]
    },
    "up": {
      "animations": [
        "jump"
      ],
      "transitions": [
        {
          "default": "q.is_on_ground||q.is_in_water"
        }
      ],
      "blend_transition": 0.24
    }
  }
}